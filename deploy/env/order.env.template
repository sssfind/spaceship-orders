# ----------------------------
# Настройки HTTP-сервера
# ----------------------------

HTTP_HOST=${ORDER_HTTP_HOST}

HTTP_PORT=${ORDER_HTTP_PORT}

HTTP_READ_TIMEOUT=${ORDER_HTTP_READ_TIMEOUT}

# Каталог со статическим UI (опционально)
FRONTEND_DIR=${ORDER_FRONTEND_DIR}

# IAM (Whoami + reverse proxy /api/v1/auth/*)
IAM_HTTP_BASE_URL=${ORDER_IAM_HTTP_BASE_URL}

# ----------------------------
# Настройки логгера
# ----------------------------

LOGGER_LEVEL=${ORDER_LOGGER_LEVEL}

LOGGER_AS_JSON=${ORDER_LOGGER_AS_JSON}

LOG_OUTPUTS=${CORE_LOG_OUTPUTS}

OTEL_COLLECTOR_ENDPOINT=${CORE_OTEL_COLLECTOR_ENDPOINT}

SERVICE_NAME=order-service

# ----------------------------
# Настройки PostgreSQL
# ----------------------------

# Хост PostgreSQL-сервера (для внутренних подключений)
POSTGRES_HOST=${ORDER_POSTGRES_HOST}

# Внутренний порт PostgreSQL
POSTGRES_PORT=${ORDER_POSTGRES_PORT}

# Внешний порт PostgreSQL (для подключения извне контейнера)
EXTERNAL_POSTGRES_PORT=${ORDER_EXTERNAL_POSTGRES_PORT}

POSTGRES_HOST_EXTERNAL=localhost

POSTGRES_USER=${ORDER_POSTGRES_USER}

POSTGRES_PASSWORD=${ORDER_POSTGRES_PASSWORD}

# Название базы данных
POSTGRES_DB=${ORDER_POSTGRES_DB}

# Режим подключения по SSL (например, disable, require)
POSTGRES_SSL_MODE=${ORDER_POSTGRES_SSL_MODE}

MIGRATION_DIRECTORY=${ORDER_MIGRATION_DIRECTORY}
