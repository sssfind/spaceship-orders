# Core / Kafka
# ----------------------------
CORE_KAFKA_EXTERNAL_PORT=9092
CORE_KAFKA_INTERNAL_PORT=29092
CORE_KAFKA_CONTROLLER_PORT=9093
CORE_KAFKA_UI_PORT=8080

