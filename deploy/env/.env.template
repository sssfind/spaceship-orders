# ==============================================================================
# MASTER CONFIGURATION TEMPLATE (.env.template)
# ==============================================================================

# ----------------------------
# Core / Observability
# ----------------------------
CORE_OTEL_COLLECTOR_ENDPOINT=otel-collector:4317
CORE_LOG_OUTPUTS=stdout

# ----------------------------
# Order Service
# ----------------------------
ORDER_HTTP_HOST=0.0.0.0
ORDER_HTTP_PORT=8081
ORDER_HTTP_READ_TIMEOUT=5s
ORDER_FRONTEND_DIR=/app/frontend
ORDER_LOGGER_LEVEL=info
ORDER_LOGGER_AS_JSON=false
ORDER_POSTGRES_HOST=orders_db
ORDER_POSTGRES_PORT=5432
ORDER_EXTERNAL_POSTGRES_PORT=5432
ORDER_POSTGRES_USER=postgres
ORDER_POSTGRES_PASSWORD=postgres
ORDER_POSTGRES_DB=orders
ORDER_POSTGRES_SSL_MODE=disable
ORDER_MIGRATION_DIRECTORY=migrations
ORDER_IAM_HTTP_BASE_URL=http://iam_app:8082

# ----------------------------
# IAM Service
# ----------------------------
IAM_HTTP_HOST=0.0.0.0
IAM_HTTP_PORT=8082
IAM_HTTP_READ_TIMEOUT=5s
IAM_LOGGER_LEVEL=info
IAM_LOGGER_AS_JSON=false
IAM_POSTGRES_HOST=iam_db
IAM_POSTGRES_PORT=5432
IAM_EXTERNAL_POSTGRES_PORT=5433
IAM_POSTGRES_USER=postgres
IAM_POSTGRES_PASSWORD=postgres
IAM_POSTGRES_DB=iam
IAM_POSTGRES_SSL_MODE=disable
IAM_MIGRATION_DIRECTORY=migrations
IAM_SESSION_TTL=24h
